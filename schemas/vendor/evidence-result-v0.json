{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentactioncapsule.org/schemas/evidence-result-v0.json",
  "$comment": "Vendored, not owned here. This is a literal transcription of agent-action-capsule's schemas/evidence-result-v0.json (spec/evidence-result-v0.md, sections 1-3 ruled 2026-09-22) -- created here because, when it was vendored, that repo's schema was on a branch and not yet on agent-action-capsule's main (so not importable from the agent-action-capsule>=0.1.0 PyPI dependency this repo already pins). A change to the owning schema is a drift that must be re-vendored here, not silently re-derived -- same discipline as schemas/vendor/epistemic-types.json. Drop this vendored copy and import the schema from agent-action-capsule directly once that repo ships it (PyPI release or an importable schema resource) -- see capsule_engine/report/result.py's module docstring.",
  "x_vendor_source": {
    "repo": "agent-action-capsule",
    "path": "schemas/evidence-result-v0.json",
    "branch": "batch4-evidence-result-schema-v0",
    "commit": "24ee05af4b620ce85a5d6aabeeb9e4f0ad394ebb",
    "vendored_at": "2026-09-22",
    "coverage_report": {
      "comment": "The PROPOSED coverage_report section (CoverageStatus through CoverageReport in $defs, and EvidenceResult.properties.coverage_report) is transcribed from this branch and commit; the rest of the file is unchanged from the base above.",
      "branch": "feat/result-coverage-report",
      "commit": "8fab359fe1f61310dd47ccb7d8779913f33482e2",
      "vendored_at": "2026-09-30"
    }
  },
  "title": "Evidence Result v0",
  "description": "Companion schema for spec/evidence-result-v0.md. Sections 1-3 of the companion document (result semantics, disclosure policy, aggregate/coverage) carry the 2026-09-22 ruling (quoted verbatim there); this schema encodes that ruling and is no longer DRAFT. The root schema validates an Evidence Result document.",
  "$ref": "#/$defs/EvidenceResult",
  "$defs": {
    "HexDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DigestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_alg",
        "digest"
      ],
      "properties": {
        "digest_alg": {
          "const": "SHA-256"
        },
        "digest": {
          "$ref": "#/$defs/HexDigest"
        }
      }
    },
    "ContractRef": {
      "description": "Compact versioned Evidence Contract reference: <contract_id>@<version>. Same convention as evidence-plan-ir-v0.json's ContractRef -- a claim never carries a bare, unversioned contract id.",
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    },
    "Tier": {
      "description": "spec/evidence-result-v0.md section 1 -- mirrored from evidence-plan-ir-v0.md section 4.2, not redefined here.",
      "enum": [
        "recomputed",
        "judged"
      ]
    },
    "Grade": {
      "description": "The three-value assurance grade owned by [grade-vocabulary-reconcile]; mirrored here, never redefined.",
      "enum": [
        "self-attested",
        "witnessed",
        "countersigned"
      ]
    },
    "Sufficiency": {
      "description": "The four-value Evidence Contract sufficiency result: whether enough of the right evidence was found, committed, and disclosed to make a determination on the requirement at all. Owned by the Evidence Contract, mirrored here, never redefined.",
      "enum": [
        "SATISFIED",
        "GAP",
        "INSUFFICIENT",
        "UNKNOWN"
      ]
    },
    "Verdict": {
      "description": "The three-value judged-outcome vocabulary of the Evidence Contract: met or not_met only when sufficiency is SATISFIED, otherwise not_evaluable. Owned by the Evidence Contract, mirrored here, never redefined.",
      "enum": [
        "met",
        "not_met",
        "not_evaluable"
      ]
    },
    "EvidenceStatus": {
      "description": "The eight-value per-requirement bundle assertion status of the Evidence Contract, the same closed set evidence-plan-ir-v0.json's ResultEnvelope.status mirrors. Owned by the Evidence Contract, mirrored here for the same reason: the disclosure policy (spec section 2) needs the WITHHELD/NOT_COMMITTED distinction that the Sufficiency projection collapses into GAP.",
      "enum": [
        "SATISFIED",
        "INSUFFICIENT",
        "NOT_FOUND",
        "NOT_COMMITTED",
        "WITHHELD",
        "CONTRADICTED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "DisclosedStatus": {
      "description": "EvidenceStatus minus the two statuses the disclosure policy (spec section 2) reserves for the analysis/story carriers: WITHHELD and NOT_COMMITTED.",
      "enum": [
        "SATISFIED",
        "INSUFFICIENT",
        "NOT_FOUND",
        "CONTRADICTED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "ProofRef": {
      "description": "An inclusion proof or receipt ref, by digest only -- never inline bytes (spec section 5).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "digest_alg",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "inclusion_proof",
            "receipt"
          ]
        },
        "digest_alg": {
          "const": "SHA-256"
        },
        "digest": {
          "$ref": "#/$defs/HexDigest"
        }
      }
    },
    "DisclosureCarrier": {
      "description": "spec section 2 -- the full carrier. Legal only when status is not WITHHELD/NOT_COMMITTED. Never carries payload bytes: evidence is by digest only, identical in shape to Claim.evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "disclosure"
        },
        "status": {
          "$ref": "#/$defs/DisclosedStatus"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DigestRef"
          }
        }
      }
    },
    "AnalysisCarrier": {
      "description": "spec section 2 -- a derived characterization of evidence that is not (fully) disclosed. summary MUST NOT quote or closely paraphrase the underlying payload -- it characterizes, it does not disclose.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "summary"
      ],
      "properties": {
        "kind": {
          "const": "analysis"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "StoryCarrier": {
      "description": "spec section 2 -- narrative-only, the weakest carrier, for claims with no derived characterization to share. narrative describes the process, never the withheld content itself.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "narrative"
      ],
      "properties": {
        "kind": {
          "const": "story"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "narrative": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Presentation": {
      "oneOf": [
        {
          "$ref": "#/$defs/DisclosureCarrier"
        },
        {
          "$ref": "#/$defs/AnalysisCarrier"
        },
        {
          "$ref": "#/$defs/StoryCarrier"
        }
      ]
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract_ref",
        "requirement_ref",
        "tier",
        "grade",
        "sufficiency",
        "verdict",
        "evidence",
        "proofs",
        "presentation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "contract_ref": {
          "$ref": "#/$defs/ContractRef"
        },
        "requirement_ref": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "grade": {
          "$ref": "#/$defs/Grade"
        },
        "sufficiency": {
          "$ref": "#/$defs/Sufficiency"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DigestRef"
          }
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProofRef"
          }
        },
        "presentation": {
          "$ref": "#/$defs/Presentation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sufficiency": {
                "const": "SATISFIED"
              }
            }
          },
          "then": {
            "properties": {
              "verdict": {
                "enum": [
                  "met",
                  "not_met"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "verdict": {
                "const": "not_evaluable"
              }
            }
          }
        }
      ]
    },
    "Coverage": {
      "description": "spec section 3 -- MANDATORY on every aggregate. An aggregate without this fails validation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_population",
        "excluded_not_applicable",
        "unknown_count"
      ],
      "properties": {
        "evaluated_population": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Buckets": {
      "description": "spec section 3 -- every evaluated claim, grouped by verdict. Always three keys, never a single number; an empty bucket is an empty array, not an absent key.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "met",
        "not_met",
        "not_evaluable"
      ],
      "properties": {
        "met": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_met": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_evaluable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "buckets"
      ],
      "properties": {
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "buckets": {
          "$ref": "#/$defs/Buckets"
        }
      }
    },
    "CoverageStatus": {
      "description": "PROPOSED (spec section 7.1). The per-requirement coverage status: the subset of EvidenceStatus a coverage computation over ledger records can produce. Coverage says whether evidence is there to evaluate; it is never a verdict.",
      "enum": [
        "SATISFIED",
        "INSUFFICIENT",
        "NOT_FOUND",
        "UNKNOWN"
      ]
    },
    "Connector": {
      "description": "PROPOSED (spec section 7.1). The hook class that would capture a missing source.",
      "enum": [
        "otel",
        "mcp_proxy",
        "gateway",
        "git_ci",
        "system_of_record",
        "native_emission",
        "human_approval"
      ]
    },
    "AssuranceMode": {
      "description": "PROPOSED (spec section 7.1). The assurance mode a connector raises a source to.",
      "enum": [
        "retrospectively_evidenced",
        "observed",
        "committed"
      ]
    },
    "Remedy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector",
        "raises_to"
      ],
      "properties": {
        "connector": {
          "$ref": "#/$defs/Connector"
        },
        "raises_to": {
          "$ref": "#/$defs/AssuranceMode"
        }
      }
    },
    "SourceCoverage": {
      "description": "PROPOSED (spec section 7.1). What evidence exists for one required source: counts after duplicate collapse, distinct producers, and the record digests. NOT_FOUND exactly when record_count is 0.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "record_count",
        "contemporaneous_count",
        "backfilled_count",
        "duplicates_collapsed",
        "producer_count",
        "evidence"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "SATISFIED",
            "INSUFFICIENT",
            "NOT_FOUND"
          ]
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "contemporaneous_count": {
          "type": "integer",
          "minimum": 0
        },
        "backfilled_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates_collapsed": {
          "type": "integer",
          "minimum": 0
        },
        "producer_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DigestRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_FOUND"
              }
            }
          },
          "then": {
            "properties": {
              "record_count": {
                "const": 0
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "record_count": {
                "minimum": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Independence": {
      "description": "PROPOSED (spec section 7.1). Producers, not records, are counted: records from one producer are correlation, never corroboration.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_producers",
        "independent_producers",
        "correlated_records",
        "met"
      ],
      "properties": {
        "required_producers": {
          "type": "integer",
          "minimum": 1
        },
        "independent_producers": {
          "type": "integer",
          "minimum": 0
        },
        "correlated_records": {
          "type": "integer",
          "minimum": 0
        },
        "met": {
          "type": "boolean"
        }
      }
    },
    "CoverageGap": {
      "description": "PROPOSED (spec section 7.1). What is missing, and the source and connector that would close it. remedy is null when no connector is named; that gap is counted in summary.gaps_without_remedy, never dropped.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail",
        "remedy"
      ],
      "properties": {
        "kind": {
          "enum": [
            "missing_source",
            "assurance_below_minimum",
            "correlated_only",
            "no_sources_declared"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "remedy": {
          "oneOf": [
            {
              "$ref": "#/$defs/Remedy"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "missing_source",
                  "assurance_below_minimum"
                ]
              }
            }
          },
          "then": {
            "required": [
              "source"
            ]
          }
        }
      ]
    },
    "RequirementCoverage": {
      "description": "PROPOSED (spec section 7.1). One requirement's coverage. sufficiency is derived from status by a fixed mapping (SATISFIED->SATISFIED, NOT_FOUND->GAP, INSUFFICIENT->INSUFFICIENT, UNKNOWN->UNKNOWN). A SATISFIED row has no gaps and met independence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_ref",
        "obligation_refs",
        "status",
        "sufficiency",
        "claim_ids",
        "sources",
        "independence",
        "gaps"
      ],
      "properties": {
        "requirement_ref": {
          "type": "string",
          "minLength": 1
        },
        "obligation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "sufficiency": {
          "$ref": "#/$defs/Sufficiency"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceCoverage"
          }
        },
        "independence": {
          "$ref": "#/$defs/Independence"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoverageGap"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SATISFIED"
              }
            }
          },
          "then": {
            "properties": {
              "sufficiency": {
                "const": "SATISFIED"
              },
              "gaps": {
                "maxItems": 0
              },
              "independence": {
                "properties": {
                  "met": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_FOUND"
              }
            }
          },
          "then": {
            "properties": {
              "sufficiency": {
                "const": "GAP"
              },
              "gaps": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "INSUFFICIENT"
              }
            }
          },
          "then": {
            "properties": {
              "sufficiency": {
                "const": "INSUFFICIENT"
              },
              "gaps": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "sufficiency": {
                "const": "UNKNOWN"
              }
            }
          }
        }
      ]
    },
    "CoverageSummary": {
      "description": "PROPOSED (spec section 7.1). Counts recomputed from the requirement rows; a summary that does not recompute is rejected by the cross-element check, not by this schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "satisfied",
        "with_gaps",
        "gaps",
        "gaps_without_remedy"
      ],
      "properties": {
        "requirements": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied": {
          "type": "integer",
          "minimum": 0
        },
        "with_gaps": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "integer",
          "minimum": 0
        },
        "gaps_without_remedy": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CoverageReport": {
      "description": "PROPOSED (spec section 7.1). Coverage per requirement of one contract version: what evidence exists, what is missing, and which source would close it. Optional; aggregate.coverage stays mandatory and renders first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version",
        "contract_ref",
        "requirements",
        "summary"
      ],
      "properties": {
        "spec_version": {
          "const": "coverage-report/v0"
        },
        "contract_ref": {
          "$ref": "#/$defs/ContractRef"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementCoverage"
          }
        },
        "summary": {
          "$ref": "#/$defs/CoverageSummary"
        }
      }
    },
    "View": {
      "description": "spec section 8 -- presentation hints only, never data. presentation/v1 header fields: producer name, logo data URL, title.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version"
      ],
      "properties": {
        "spec_version": {
          "const": "presentation/v1"
        },
        "producer_name": {
          "type": "string",
          "minLength": 1
        },
        "logo_data_url": {
          "type": "string",
          "pattern": "^data:"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "EvidenceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_version",
        "generated_at",
        "claims",
        "aggregate"
      ],
      "properties": {
        "result_version": {
          "const": "evidence-result-v0"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "aggregate": {
          "$ref": "#/$defs/Aggregate"
        },
        "view": {
          "$ref": "#/$defs/View"
        },
        "coverage_report": {
          "$ref": "#/$defs/CoverageReport"
        }
      }
    }
  }
}
